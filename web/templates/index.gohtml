<!doctype HTML>
<html lang="{{.Locale.Tag}}" dir="{{.Locale.Direction}}" writing-mode="{{.Locale.WritingMode}}">
{{template "partials/head"}}
<body>
{{template "partials/header" .}}

<main>
    {{if eq (len .Data) 0}}
        <article>
            {{.Translations.Get "Zero matches"}}
        </article>
    {{end}}

    {{range .Data}}
        <article>
            <header>
                <div class="title">{{.Title}}</div>
                <div class="metadata">
                    {{if ne .Published nil}}
                        {{.Published.Format "2006-01-02"}}
                    {{end}}
                </div>
            </header>
            Summary will go here.
            <footer>
                <a href="{{.Path}}">{{$.Translations.Get "Continue reading..."}}</a>
            </footer>
        </article>
    {{end}}
</main>

</body>
</html>
