<header>
    <nav>
        <ul>
            <li>
                <a href="/">
                    <img src="/_static/media/logo.svg" alt="{{.Translations.Get "Website logo"}}" style="height: 1em; width: 1em;">
                    Musings
                </a>
            </li>
        </ul>
        <div>
            <form action="/" method="get">
                <label class="sr-only" for="search">Search</label>
                <input id="search" name="q" type="search">
            </form>
        </div>
        <ul>
            <li>
                {{template "partials/locales" .}}
            </li>
        </ul>
    </nav>
</header>