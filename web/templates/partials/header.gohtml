<header id="main-header">
    <div class="container">
        <a href="{{.RootURL}}">
            <img src="{{"/_static/images/favicon.svg" | versioned}}"
                 alt="{{.Translations.Get "Website logo"}}"
                 style="height: 2rem; width: 2rem;"
            >
            <span>Musings</span>
        </a>

        <form action="{{.RootURL}}" method="get">
            <label class="visually-hidden" for="search">
                {{.Translations.Get "Search"}}
            </label>
            <input id="search" name="q" type="search">
        </form>

        <div class="locale-switcher">
            {{template "partials/locales" .}}
        </div>
    </div>
</header>