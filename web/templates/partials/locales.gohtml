{{if and (eq (len .LocaleOptions) 1) (eq .Locale.Tag "und")}}
    <!-- No languages are configured. -->
{{else}}
    <details class="dropdown">
        <summary>
            <span
                aria-label="{{.Translations.Get "Select Langauge"}}"
                aria-hidden="true"
            >文Ａ &ndash; {{.Locale.NativeName}}</span>
        </summary>
        <ul dir="rtl">
            {{range .LocaleOptions}}
                <li dir="auto">
                    {{if .IsCurrent}}
                        <strong>{{.NativeName}}</strong>
                    {{else}}
                        <a href="{{.URL}}">{{.NativeName}}</a>
                    {{end}}
                </li>
            {{end}}
        </ul>
    </details>
{{end}}