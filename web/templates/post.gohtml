<!doctype HTML>
<html lang="{{.Locale.Tag}}" dir="{{.Locale.Direction}}" class="{{.Locale.WritingMode}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Musings</title>

    {{template "partials/favicons"}}

    <link rel="stylesheet" href="{{"/_static/css/default.css" | versioned}}">
</head>
<body class="post-page">
{{template "partials/header" .}}

<main class="container">
    <article>
        <header>
            <h1 class="title">{{.Data.Title}}</h1>
            <div class="metadata">
                {{range .Data.Bylines}}
                    {{.}}<br>
                {{end}}
                {{if ne .Data.Published nil}}
                    {{.Translations.Get "published"}}
                    {{$.FormatDate .Data.Published}}<br>
                {{end}}
            </div>
        </header>

        {{.Data.Content}}
    </article>
</main>

</body>
</html>
